default:
    @just --list

# Run all tests
test:
    cargo test --all-targets
    cargo test --all-targets --no-default-features

# Run clippy
clippy:
    cargo clippy --all-targets -- -D warnings
    cargo clippy --all-targets --no-default-features -- -D warnings

# Format code
fmt:
    cargo fmt

# Check formatting
fmt-check:
    cargo fmt --check

# Feature permutation checks
feature-check:
    cargo test --all-targets
    cargo test --all-targets --no-default-features
    cargo check --all-targets --all-features

# Build release
build:
    cargo build --release --all-features

# Run all CI checks locally
ci: fmt-check clippy test feature-check

# Cross-check the structural inventory against mutool and exiftool on a
# directory of real PDFs (searched recursively). Writes the result table to
# `report`.
inventory-oracle dir report="inventory-oracle-pdf.tsv":
    INVENTORY_ORACLE_MUTOOL="$(command -v mutool)" INVENTORY_ORACLE_EXIFTOOL="$(command -v exiftool)" INVENTORY_ORACLE_PDF_DIR="{{dir}}" INVENTORY_ORACLE_REPORT="{{report}}" cargo test --test inventory oracle_mutool_exiftool -- --nocapture
